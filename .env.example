# Formspree contact endpoint (never commit real secrets).
# 1. Create a free form at https://formspree.io for your contact email.
# 2. Copy the form ID shown there, e.g. "mqkrznab".
# 3. Create a local .env file with the line below and restart the dev server.
#
# If this variable is unset, the contact form gracefully falls back to
# composing a pre-filled email in the visitor's mail client.
VITE_FORMSPREE_ENDPOINT=https://formspree.io/f/yourFormId
