# Formspree contact endpoint (never commit real secrets).
# 1. Create a free form at https://formspree.io for your contact email.
# 2. Copy the form ID shown there, e.g. "mqkrznab".
# 3. Create a local .env file with the line below and restart the dev server.
#
# If this variable is unset, the contact form gracefully falls back to
# composing a pre-filled email in the visitor's mail client.
VITE_FORMSPREE_ENDPOINT=https://formspree.io/f/yourFormId

# ----------------------------------------------------------------
# RIDER assistant (server-side, Vercel serverless function api/chat.js)
# Set these in Vercel > Project > Settings > Environment Variables.
# The key is NEVER exposed to the browser.
# ----------------------------------------------------------------
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
ASSISTANT_TEMPERATURE=0.2
ASSISTANT_MAX_MESSAGES_PER_HOUR=20
ASSISTANT_MAX_MESSAGE_LENGTH=2000
# Jev (TypeSafe System One) guardrail layer — optional; when unset the
# assistant skips calibrated pre/post-guard judgments gracefully.
TYPESAFE_API_KEY=
# Same-origin lead webhook (server var, no VITE_ prefix):
FORMSPREE_ENDPOINT=https://formspree.io/f/yourFormId
# Dev only: canned replies without a key (remove on Vercel):
ASSISTANT_MOCK=true
